{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Vinos de usuario",
    "description": "Lista de los vinos valorados por un usuario o que sigue un usuario",
    "type": "object",
    "properties": {
        "id":{
            "description":"Identificador de la relación Vino-Usuario",
            "type": "integer"
        },
        "id_usuario":{
            "description":"Identificador del usuario",
            "type": "integer"
        },
        "id_vino":{
            "description":"Identificador del vino",
            "type": "integer"
        },
        "puntuacion":{
            "description":"Puntuación del vino",
            "type": "number",
            "minimum": 0,
            "maximum": 10
        },
        "fecha_anadido":{
            "description":"Fecha en la que has anadido el vino a la lista",
            "type": "string"
        }
    },
    "required": ["id_usuario","id_vino","puntuacion","fecha_anadido"]
}